# ClearTerms backend configuration template.
# Copy to `.env` (without overwriting an existing one) and fill values:
#   cp -n .env.example .env
# All settings are optional in dev — the app has working defaults for each.
# Only ENVIRONMENT=prod hardens startup and forces a real JWT_SECRET.
# Every key is prefixed CLEARTERMS_ and read by pydantic-settings.

# --- Deployment ---
CLEARTERMS_ENVIRONMENT=
CLEARTERMS_LOG_LEVEL=

# --- Database (async asyncpg URL) ---
CLEARTERMS_DATABASE_URL=
CLEARTERMS_DB_POOL_SIZE=
CLEARTERMS_DB_MAX_OVERFLOW=
CLEARTERMS_DB_POOL_TIMEOUT=
CLEARTERMS_DB_POOL_RECYCLE=
CLEARTERMS_DB_STATEMENT_TIMEOUT_MS=

# --- Auth / JWT (set a real >=32-byte secret in prod) ---
CLEARTERMS_JWT_SECRET=
CLEARTERMS_JWT_ALGORITHM=
CLEARTERMS_JWT_EXPIRE_MINUTES=

# --- LLM backend (set OPENROUTER_API_KEY to use OpenRouter; else local Ollama) ---
CLEARTERMS_OLLAMA_BASE_URL=
CLEARTERMS_OPENROUTER_API_KEY=
CLEARTERMS_AGENT_MODEL=
CLEARTERMS_MODEL_VERSION=

# --- Analysis pipeline ---
CLEARTERMS_MAX_ANALYZE_BYTES=
CLEARTERMS_CHUNK_TOKENS=
CLEARTERMS_CHUNK_OVERLAP_TOKENS=
CLEARTERMS_ANALYSIS_WORKERS=
CLEARTERMS_ANALYSIS_QUEUE_MAXSIZE=
CLEARTERMS_ANALYSIS_QUEUE_TIMEOUT_SECONDS=
CLEARTERMS_ANALYSIS_QUEUE_ALPHA=

# --- Rate limiting ---
CLEARTERMS_RATE_LIMIT_LOGIN_MAX=
CLEARTERMS_RATE_LIMIT_LOGIN_WINDOW_SECONDS=
CLEARTERMS_RATE_LIMIT_ANALYZE_MAX=
CLEARTERMS_RATE_LIMIT_ANALYZE_WINDOW_SECONDS=
CLEARTERMS_RATE_LIMIT_SWEEP_INTERVAL_SECONDS=

# --- Object storage (MinIO in dev, S3 in prod) ---
CLEARTERMS_S3_ENDPOINT_URL=
CLEARTERMS_S3_PUBLIC_ENDPOINT_URL=
CLEARTERMS_S3_BUCKET=
CLEARTERMS_S3_ACCESS_KEY=
CLEARTERMS_S3_SECRET_KEY=
CLEARTERMS_S3_REGION=
CLEARTERMS_MEDIA_URL_TTL_SECONDS=

# --- Upload limits ---
CLEARTERMS_MAX_IMAGE_BYTES=
CLEARTERMS_MAX_VIDEO_BYTES=
CLEARTERMS_MAX_VIDEO_DURATION_SECONDS=
CLEARTERMS_MAX_ATTACHMENTS_PER_ITEM=
CLEARTERMS_VIDEO_MAX_HEIGHT=
CLEARTERMS_IMAGE_MAX_DIMENSION=
CLEARTERMS_ALLOWED_IMAGE_MIMES=
CLEARTERMS_ALLOWED_VIDEO_MIMES=
