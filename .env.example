# Compose-stack secrets for `docker compose up` / `./run.sh docker`.
# Copy to `.env` (repo root — compose reads it automatically) and fill values:
#   cp -n .env.example .env
# `.env` is gitignored. These are REQUIRED: compose errors out if any is unset.
# This is separate from backend/.env.example (that one is for host `uvicorn` dev).

# JWT signing secret. >=32 bytes. Generate with: openssl rand -hex 32
CLEARTERMS_JWT_SECRET=

# Postgres password (user/db are both `clearterms`). Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# MinIO root credentials — also used by the backend as its S3 access/secret key.
# User defaults to `clearterms` if unset; password is required.
MINIO_ROOT_USER=clearterms
MINIO_ROOT_PASSWORD=
